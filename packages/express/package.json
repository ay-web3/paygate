{
  "name": "@emmanue5002k/paygate-express",
  "version": "0.1.0",
  "description": "Express middleware adapter for PayGate x402 SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emmanue5002k/paygate-core": "*",
    "@x402/express": "latest"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.19.2",
    "tsup": "^8.0.2"
  },
  "peerDependencies": {
    "express": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}