{
  "name": "@emmanue5002k/paygate-dashboard",
  "version": "0.1.0",
  "description": "Revenue analytics dashboard for PayGate x402 SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emmanue5002k/paygate-core": "*",
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "tsup": "^8.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}